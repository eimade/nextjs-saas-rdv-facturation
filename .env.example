# Copier en .env pour le développement local (docker compose up -d db mailpit).
DATABASE_URL="postgresql://kalendo:kalendo@localhost:15432/kalendo?schema=public"
# Générer avec : npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="remplacer-par-une-valeur-aleatoire"
AUTH_TRUST_HOST="true"
APP_URL="http://localhost:13000"
# Emails : "console" (bouchon, journalise) ou "smtp" (Mailpit local, http://localhost:18025)
MAIL_TRANSPORT="smtp"
SMTP_HOST="localhost"
SMTP_PORT="11025"
MAIL_FROM="Kalendo <no-reply@kalendo.local>"
# Planification du worker de rappels (cron) et fenêtre de rappel en heures
REMINDER_CRON="*/5 * * * *"
REMINDER_HOURS_AHEAD="24"
