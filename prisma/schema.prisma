// Uimad Agenda : modèle de données multi-tenant.
// Toutes les tables portant un tenant_id sont protégées par Row Level Security
// (voir prisma/migrations/*_rls). Tenant et User sont globales.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  PRACTITIONER
  SECRETARY
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  timezone  String   @default("Europe/Paris")
  currency  String   @default("EUR")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  memberships  Membership[]
  invitations  Invitation[]
  services     Service[]
  clients      Client[]
  appointments Appointment[]
  availability Availability[]
  absences     Absence[]
  invoices     Invoice[]
  counters     InvoiceCounter[]

  @@map("tenants")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  membership Membership?

  @@map("users")
}

/// MVP : un utilisateur appartient à un seul cabinet (userId unique).
model Membership {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  userId    String   @unique @map("user_id")
  role      Role
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability Availability[]
  absences     Absence[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("memberships")
}

model Invitation {
  id         String    @id @default(cuid())
  tenantId   String    @map("tenant_id")
  email      String
  role       Role
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invitations")
}

model Service {
  id          String  @id @default(cuid())
  tenantId    String  @map("tenant_id")
  name        String
  durationMin Int     @map("duration_min")
  priceCents  Int     @map("price_cents")
  active      Boolean @default(true)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([tenantId])
  @@map("services")
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  email     String
  phone     String?
  locale    String   @default("fr")
  createdAt DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([tenantId, email])
  @@map("clients")
}

/// Plage hebdomadaire de disponibilité (minutes depuis minuit, heure locale du cabinet).
model Availability {
  id           String @id @default(cuid())
  tenantId     String @map("tenant_id")
  membershipId String @map("membership_id")
  weekday      Int // 0 = dimanche … 6 = samedi
  startMinute  Int    @map("start_minute")
  endMinute    Int    @map("end_minute")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@map("availability")
}

model Absence {
  id           String   @id @default(cuid())
  tenantId     String   @map("tenant_id")
  membershipId String   @map("membership_id")
  startsAt     DateTime @map("starts_at")
  endsAt       DateTime @map("ends_at")
  reason       String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([tenantId, membershipId])
  @@map("absences")
}

/// Contrainte d'exclusion GiST (migration SQL) : pas deux RDV actifs qui se chevauchent pour un même praticien.
model Appointment {
  id             String            @id @default(cuid())
  tenantId       String            @map("tenant_id")
  membershipId   String            @map("membership_id")
  serviceId      String            @map("service_id")
  clientId       String            @map("client_id")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(BOOKED)
  reminderSentAt DateTime?         @map("reminder_sent_at")
  createdAt      DateTime          @default(now()) @map("created_at")

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: NoAction)
  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice    Invoice?

  @@index([tenantId, startsAt])
  @@map("appointments")
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  appointmentId String        @unique @map("appointment_id")
  number        String
  amountCents   Int           @map("amount_cents")
  status        InvoiceStatus @default(UNPAID)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  paidAt        DateTime?     @map("paid_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@map("invoices")
}

/// Compteur de numérotation des factures, par tenant et par année.
model InvoiceCounter {
  tenantId String @map("tenant_id")
  year     Int
  last     Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("invoice_counters")
}
